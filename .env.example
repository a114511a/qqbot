# NoneBot2 服务端监听设置
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080

# 与 NapCat OneBot V11 反向 WebSocket 配置中的 access token 保持一致；建议改成随机长字符串
ONEBOT_ACCESS_TOKEN=please-change-to-a-long-random-token

# NapCat WebUI 登录 token（仅本机 127.0.0.1:6099 可访问）；请替换为随机长字符串
NAPCAT_WEBUI_TOKEN=please-change-to-another-long-random-token

# 机器人 QQ 号。容器重建时 NapCat 用它做快速登录，复用 data/qq 里已保存的登录态，
# 不必重新扫码。留空则每次都要扫码登录。
QQ_ACCOUNT=

# 管理员 QQ 号（NoneBot superusers）。JSON 列表写法，多个用英文逗号分隔，不加引号。
# 拥有管理员指令权限：/update、/alias add 等。
SUPERUSERS=["123456789"]

# 落雪中二节奏开发者 API Token。需在落雪开放平台申请，并允许第三方读取玩家资料和成绩。
# 不要填落雪账号密码。令牌只存本地，不要提交到 Git。
LXNS_DEV_TOKEN=your-lxns-developer-token-here

# OpenRouter API Key（可选）。空着也能生成统计报告，但 AI 总结会使用本地规则生成。
# 免费模型默认 Gemma 4 31B；免费额度/限流由 OpenRouter 当前政策决定。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Rikka 查分插件 ────────────────────────────────────────────────
# 静态资源目录（成绩图背景/名牌/字体）。缺资源时回退纯色背景，不影响指令。
STATIC_RESOURCE_PATH=static
# 水鱼查分器开发者密钥（可选，留空则只支持落雪）
DIVINGFISH_DEVELOPER_API_KEY=
# 机台源查询与写入操作（六倍票/登出/解锁），默认关闭
ENABLE_ARCADE_PROVIDER=false
ENABLE_ARCADE_WRITE=false

# ── 中二成绩图 · 名片收藏品 ────────────────────────────────────────
# 落雪开发者接口不返回玩家装备的名牌底板，这里可以手动指定。
# 可选 ID 见 static/chu/plate/。0 = 纯色底板；留空 = 默认底板 1。
CHU_NAME_PLATE_ID=
# 按 QQ 号分别指定（JSON 对象），优先于上面的默认值，例：
# CHU_NAME_PLATE_BY_USER={"484413313": 8, "2042006164": 23}

# nonebot-plugin-orm 数据库（Rikka 使用），与底力分析的 chunithm.sqlite3 分开
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///data/rikka.sqlite3

# ── 群功能（欢迎新成员 / 戳一戳 / 机厅人数）────────────────────────────
# 下面是 group_events 插件的开关。留空的群列表 = 所有群都生效。
WELCOME_ENABLED=true
WELCOME_GROUPS=[]
POKE_ENABLED=true
POKE_GROUPS=[]
# 每人戳一戳的冷却秒数，0 = 不限
POKE_CD=2
# 机厅人数只在指定群启用，留空 = 所有群
ARCADE_GROUPS=[]
# otto 活字印刷的音节音频放在 data/ottohzys/（不入库，见 README）

