# Python 虚拟环境与依赖缓存
.venv/
.uv-cache/
__pycache__/
*.py[cod]

# 本地配置：含 OneBot token、NapCat WebUI token、落雪密钥等，绝不提交
# 同时覆盖 .env.bak / .env.local 等派生文件，避免备份时把密钥带进 Git
.env
.env.*
!.env.example

# 运行时数据：QQ 登录态、绑定库、曲目缓存、临时报告图
/data/

# 系统与临时文件
.DS_Store
*.tmp

# 运行期产物与参考图（含真实/第三方数据，不入库）
/outputs/

# 静态资源（4.5MB 曲目拟合数据 + 后续下载的封面/名牌），按需自行获取
# 只保留目录占位与 music_chart.json 说明，实际图片资源不入库
/static/mai/cover/
/static/mai/plate/
/static/mai/icon/
/static/mai/frame/
/static/mai/pic/
/static/font/

# 运行日志（Rikka 会写入 logs/），可能含 QQ 号与请求细节
/logs/

# 插件运行期自动下载/生成的静态文件，不入库
/static/echarts.min.js
/static/temp_pie.html

# 中二节奏静态资源（游戏 UI 素材 + 下载的全部曲绘/名牌，按需自行获取）
/static/chu/

# 舞萌静态资源（运行时按需下载，体积较大）
/static/mai/

# 用户自定义的名牌底板选择（含 QQ 号，不入库）
/data/chu_name_plates.json

# VS Code 工作区配置
/.vscode/
